# Gradle
.gradle/
build/
out/

# Java
*.class
hs_err_pid*
replay_pid*

# Python (updater)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Updater session output: live-probe overlays and repair bundles are per-run diagnostics.
# Mappings, reports and index.json are the API's contract and are committed.
mappings/*.live.json
mappings/*.repair/

# Client binaries and Ghidra models live outside the repo (~/.kraken-native); never commit them
*.exe
*.dll

# IDEs and local settings
.idea/
*.iml
.vscode/
.claude/settings.local.json
.env

# OS
.DS_Store
Thumbs.db
*.log
